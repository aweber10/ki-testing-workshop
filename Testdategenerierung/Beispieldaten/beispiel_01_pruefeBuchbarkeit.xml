<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════════
  BEISPIEL 1 – pruefeBuchbarkeit (einfache Gehaltsbuchung)
  ═══════════════════════════════════════════════════════════════════════════════
  Szenario:
    Monatliche Gehaltsbuchung aus SAGE.
    Belegkonto: LOHN-UND GEHALTSVER (Verbindlichkeitskonto, wird im Haben belastet)
    Position:   GEHÄLTER im Soll (Aufwand steigt)
    Kostenstelle: 1010

  Vorzeichen-Logik:
    Belegkonto (LOHN-UND GEHALTSVER) wird im Haben belastet → belegbetrag POSITIV
    Position (GEHÄLTER) wird im Soll gebucht → soll = true

  Was erwartest du als Ergebnis?
    ● Prüfcode "000000000" = alle 9 Prüfungen bestanden
    ● Jede Stelle > 0 zeigt ein spezifisches Problem an (siehe XSD-Dokumentation)

  Tipp für SoapUI:
    - WSDL importieren: File → New SOAP Project → WSDL-URL eintragen
    - Dieses XML in den Request-Editor kopieren
    - Endpoint anpassen (Rechtsklick auf Request → Edit Endpoint)
  ═══════════════════════════════════════════════════════════════════════════════
-->
<soapenv:Envelope
  xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
  xmlns:rw="http://webservice.mach.de/rechnungswesen/v11/"
  xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">

  <soapenv:Header>
    <!--
      WS-Security Header – Pflicht bei jedem Request.
      Werte mit der Schulungsumgebung abstimmen.
      Format Username: name=<rw:user>,database=<rw:db>,mandant=100,niederlassung=1
    -->
    <wsse:Security>
      <wsse:UsernameToken>
        <wsse:Username>name=schulung_user,database=schulung_db,mandant=100,niederlassung=1</wsse:Username>
        <wsse:Password
          Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">
          schulung_passwort
        </wsse:Password>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>

  <soapenv:Body>
    <rw:pruefeBuchbarkeit>
      <rw:belegdaten>

        <!-- ── Buchungssteuerung ────────────────────────────────────── -->
        <!-- Bei pruefeBuchbarkeit hat status keinen Effekt (kein Insert),
             muss aber formal angegeben werden. -->
        <rw:status>1</rw:status>

        <!-- ── Belegkopf ────────────────────────────────────────────── -->
        <rw:belegart>Umbuchung</rw:belegart>
        <rw:buchungsdatum>2026-03-31</rw:buchungsdatum>
        <rw:belegdatum>2025-03-31</rw:belegdatum>

        <!-- Belegkonto = Verbindlichkeitskonto (Haben-Seite) -->
        <rw:konto>LOHN-UND GEHALTSVER</rw:konto>
        <rw:waehrung>EUR</rw:waehrung>

        <!-- 0 = automatische Belegnummernvergabe -->
        <rw:beleg>0</rw:beleg>

        <!-- Belegbetrag: POSITIV, weil Belegkonto im HABEN belastet wird -->
        <rw:belegbetrag>5000.00</rw:belegbetrag>

        <rw:text>Gehaltsbuchung März 2025</rw:text>
        <rw:quellsystem>SAGE</rw:quellsystem>

        <!-- ── Positionen ────────────────────────────────────────────── -->
        <rw:belPositionen>
          <rw:positionsart>Sachbuchung</rw:positionsart>

          <!-- Aufwandskonto für Gehälter -->
          <rw:kontotitel>GEHÄLTER</rw:kontotitel>

          <!-- Betrag positiv, Buchungsseite über "soll" gesteuert -->
          <rw:betrag>5000.00</rw:betrag>
          <rw:betragHW>5000.00</rw:betragHW>

          <!-- true = Soll-Buchung (Aufwandskonto steigt) -->
          <rw:soll>true</rw:soll>

          <!-- false = kein USt-Handling; GEHÄLTER hat UStKontierung "keine Auswahl" -->
          <rw:brutto>false</rw:brutto>

          <!-- ustSchluessel NICHT senden für Konten ohne USt-Kontierung! -->

          <rw:text>Gehälter Abteilung Entwicklung</rw:text>

          <!-- Kostenstellen-Zuordnung (Pflicht bei BAB-Konten) -->
          <rw:aobjKontierungen>
            <rw:koReSicht>Kostenstelle</rw:koReSicht>
            <rw:aobj>1010</rw:aobj>
            <!-- Betrag = Nettobetrag (hier identisch, da brutto=false) -->
            <rw:betrag>5000.00</rw:betrag>
            <rw:betragHW>5000.00</rw:betragHW>
            <!-- erbt soll-Wert der Position -->
            <rw:soll>true</rw:soll>
          </rw:aobjKontierungen>

        </rw:belPositionen>

      </rw:belegdaten>
    </rw:pruefeBuchbarkeit>
  </soapenv:Body>

</soapenv:Envelope>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════════
  BEISPIEL 2 – insertBeleg (Gehaltsbuchung mit zwei Positionen, ohne USt)
  ═══════════════════════════════════════════════════════════════════════════════
  Szenario:
    Monatliche Gehaltsbuchung mit zwei Personalkostenarten, zwei Kostenstellen.
    Kein Umsatzsteuer-Handling (Personalkosten sind USt-frei).

  Buchungslogik:
    Belegkonto  LOHN-UND GEHALTSVER   Haben  6.500,00 € (belegbetrag positiv)
    Position 1: GEHÄLTER              Soll   5.000,00 € (Kostenstelle 1010)
    Position 2: AUSBILDUNGSVERGÜTUNG  Soll   1.500,00 € (Kostenstelle 1020)
    ──────────────────────────────────────────────────────
    Summe Positionen = 6.500,00 € = belegbetrag ✓

  Was erwartest du als Ergebnis?
    ● Erfolg: Response enthält <rw:belegKey> mit belegID > 0
    ● Fehler "Der Belegbetrag ist unvollständig auf Positionen kontiert":
      Tritt auf wenn Summe der Positionen ≠ belegbetrag
    ● Fehler "Das Sachkonto ist nicht dem Basis-BAB zugeordnet":
      Tritt auf wenn aobjKontierung für ein Bilanzkonto gesendet wird

  Übungsaufgabe für Teilnehmer:
    Verändere den belegbetrag auf 6.000,00 (Absicht: Fehler provozieren).
    Welcher Fehler kommt? Ändere dann eine Position um den Fehler zu beheben.
  ═══════════════════════════════════════════════════════════════════════════════
-->
<soapenv:Envelope
  xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
  xmlns:rw="http://webservice.mach.de/rechnungswesen/v11/"
  xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">

  <soapenv:Header>
    <wsse:Security>
      <wsse:UsernameToken>
        <wsse:Username>name=schulung_user,database=schulung_db,mandant=100,niederlassung=1</wsse:Username>
        <wsse:Password
          Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">
          schulung_passwort
        </wsse:Password>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>

  <soapenv:Body>
    <rw:insertBeleg>
      <rw:belegdaten>

        <!-- ── Buchungssteuerung ────────────────────────────────────── -->
        <!-- Status 1 = nur speichern (kein Buchungseffekt, sicher für Tests) -->
        <rw:status>1</rw:status>

        <!-- ── Belegkopf ────────────────────────────────────────────── -->
        <rw:belegart>Umbuchung</rw:belegart>
        <rw:buchungsdatum>2026-03-31</rw:buchungsdatum>
        <rw:belegdatum>2025-03-31</rw:belegdatum>

        <!-- Belegkonto: Verbindlichkeit Löhne & Gehälter (Haben-Seite) -->
        <rw:konto>LOHN-UND GEHALTSVER</rw:konto>
        <rw:waehrung>EUR</rw:waehrung>
        <rw:beleg>0</rw:beleg>

        <!--
          belegbetrag POSITIV = Belegkonto wird im Haben belastet.
          Muss exakt gleich der Summe aller Positionsbeträge sein: 5000 + 1500 = 6500
        -->
        <rw:belegbetrag>6500.00</rw:belegbetrag>

        <rw:text>Gehaltsbuchung März 2025</rw:text>
        <rw:referenz>SAGE-2025-03-GEH</rw:referenz>
        <rw:quellsystem>SAGE</rw:quellsystem>

        <!-- ── Position 1: Gehälter Abteilung Entwicklung ────────────── -->
        <rw:belPositionen>
          <rw:positionsart>Sachbuchung</rw:positionsart>
          <rw:kontotitel>GEHÄLTER</rw:kontotitel>
          <rw:betrag>5000.00</rw:betrag>
          <rw:betragHW>5000.00</rw:betragHW>
          <rw:soll>true</rw:soll>
          <rw:brutto>false</rw:brutto>
          <!-- kein ustSchluessel: GEHÄLTER hat UStKontierung "keine Auswahl" -->
          <rw:text>Gehälter Entwicklung März</rw:text>

          <rw:aobjKontierungen>
            <rw:koReSicht>Kostenstelle</rw:koReSicht>
            <rw:aobj>1010</rw:aobj>
            <rw:betrag>5000.00</rw:betrag>
            <rw:betragHW>5000.00</rw:betragHW>
            <rw:soll>true</rw:soll>
          </rw:aobjKontierungen>
        </rw:belPositionen>

        <!-- ── Position 2: Ausbildungsvergütung Kostenstelle Ausbildung ── -->
        <rw:belPositionen>
          <rw:positionsart>Sachbuchung</rw:positionsart>
          <rw:kontotitel>AUSBILDUNGSVERGÜTUNG</rw:kontotitel>
          <rw:betrag>1500.00</rw:betrag>
          <rw:betragHW>1500.00</rw:betragHW>
          <rw:soll>true</rw:soll>
          <rw:brutto>false</rw:brutto>
          <rw:text>Azubis März</rw:text>

          <rw:aobjKontierungen>
            <rw:koReSicht>Kostenstelle</rw:koReSicht>
            <rw:aobj>1020</rw:aobj>
            <rw:betrag>1500.00</rw:betrag>
            <rw:betragHW>1500.00</rw:betragHW>
            <rw:soll>true</rw:soll>
          </rw:aobjKontierungen>
        </rw:belPositionen>

      </rw:belegdaten>

      <!-- AutoKontierung aus MACH-Stammdaten nicht verwenden -->
      <rw:benutzeAutoKontierung>false</rw:benutzeAutoKontierung>

    </rw:insertBeleg>
  </soapenv:Body>

</soapenv:Envelope>

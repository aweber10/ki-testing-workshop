<?xml version="1.0" encoding="UTF-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════════
  BEISPIEL 3 – insertBeleg mit Umsatzsteuer (Bruttobuchung, brutto=true)
  ═══════════════════════════════════════════════════════════════════════════════
  Szenario:
    Reisekostenabrechnung mit zwei USt-Sätzen (7% und 19%).
    Das Konto "REISEKOSTEN" hat UStKontierung = "Vorgangsabhängig" →
    ustSchluessel MUSS mitgesendet werden.

  Buchungslogik:
    Belegkonto  VERB. LOHN U. GEHALT   Haben  112,54 € (belegbetrag positiv)

    Position 1: REISEKOSTEN (Fahrtkosten, 7% VSt)
      Bruttobetrag:  48,10 €
      Nettobetrag:   44,95 € = 48,10 / 1,07  → betrag in aobjKontierung!
      VSt-Anteil:     3,15 €  (bucht MACH intern auf Vorsteuerkonto)

    Position 2: REISEKOSTEN (Hotel, 19% VSt)
      Bruttobetrag:  64,44 €
      Nettobetrag:   54,15 € = 64,44 / 1,19  → betrag in aobjKontierung!
      VSt-Anteil:    10,29 €

    Summe Brutto: 48,10 + 64,44 = 112,54 € = belegbetrag ✓

  KRITISCHE REGEL für aobjKontierungen bei brutto=true:
    ► aobjKontierung.betrag = NETTOBETRAG (nicht Brutto!)
    ► Fehler bei Bruttobetrag: "Der Betrag der Position ist unvollständig
      der Kostenrechnung zugeordnet"

  USt-Schlüssel-Format:
    ► "VSt 07%" (MIT führender Null bei einstelligen Sätzen!)
    ► "VSt 19%"
    ► FALSCH: "VSt 7%" → Fehler "Lookup nicht gefunden"

  Übungsaufgabe für Teilnehmer:
    a) Ändere in Position 1 das aobjKontierung.betrag auf 48.10 (Brutto statt Netto).
       Welcher Fehler kommt?
    b) Ändere ustSchluessel auf "VSt 7%" (ohne führende Null).
       Welcher Fehler kommt?
    c) Sende das Beispiel gegen pruefeBuchbarkeit (nur Operation wechseln).
       Was gibt der Prüfcode zurück?
  ═══════════════════════════════════════════════════════════════════════════════
-->
<soapenv:Envelope
  xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
  xmlns:rw="http://webservice.mach.de/rechnungswesen/v11/"
  xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">

  <soapenv:Header>
    <wsse:Security>
      <wsse:UsernameToken>
        <wsse:Username>name=schulung_user,database=schulung_db,mandant=100,niederlassung=1</wsse:Username>
        <wsse:Password
          Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">
          schulung_passwort
        </wsse:Password>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>

  <soapenv:Body>
    <rw:insertBeleg>
      <rw:belegdaten>

        <!-- ── Buchungssteuerung ────────────────────────────────────── -->
        <rw:status>1</rw:status>

        <!-- ── Belegkopf ────────────────────────────────────────────── -->
        <rw:belegart>Umbuchung</rw:belegart>
        <rw:buchungsdatum>2025-03-31</rw:buchungsdatum>
        <rw:belegdatum>2025-03-28</rw:belegdatum>

        <rw:konto>VERB. LOHN U. GEHALT</rw:konto>
        <rw:waehrung>EUR</rw:waehrung>
        <rw:beleg>0</rw:beleg>

        <!--
          Summe BRUTTO beider Positionen: 48,10 + 64,44 = 112,54
          Belegkonto im Haben → belegbetrag POSITIV
        -->
        <rw:belegbetrag>112.54</rw:belegbetrag>

        <rw:text>Reisekostenabrechnung Müller März 2025</rw:text>
        <rw:referenz>SAGE-2025-03-REISE-042</rw:referenz>
        <rw:quellsystem>SAGE</rw:quellsystem>

        <!-- ═══════════════════════════════════════════════════════════
             Position 1: Fahrtkosten (7% VSt, brutto=true)
             Brutto: 48,10 €
             Netto:  44,95 € = 48,10 / 1,07  (gerundet auf 2 Dezimalstellen)
             VSt:     3,15 €  (bucht MACH automatisch intern)
             ═══════════════════════════════════════════════════════════ -->
        <rw:belPositionen>
          <rw:positionsart>Sachbuchung</rw:positionsart>
          <rw:kontotitel>REISEKOSTEN</rw:kontotitel>

          <!-- Bruttobetrag in betrag angeben bei brutto=true -->
          <rw:betrag>48.10</rw:betrag>
          <rw:betragHW>48.10</rw:betragHW>
          <rw:soll>true</rw:soll>

          <!--
            brutto=true: MACH spaltet intern in Netto + VSt auf.
            Das Vorsteuer-Konto bucht MACH automatisch.
          -->
          <rw:brutto>true</rw:brutto>

          <!--
            USt-Schlüssel MIT führender Null: "VSt 07%" nicht "VSt 7%"!
            Lookuptext der Gruppe "USt" in MACH.
          -->
          <rw:ustSchluessel>VSt 07%</rw:ustSchluessel>

          <rw:text>Bahnticket Frankfurt-Berlin</rw:text>

          <!--
            aobjKontierung: NETTOBETRAG angeben!
            Netto = 48,10 / 1,07 = 44,953... → gerundet 44.95
            Bei Bruttobetrag käme der Fehler:
            "Der Betrag der Position ist unvollständig der Kostenrechnung zugeordnet"
          -->
          <rw:aobjKontierungen>
            <rw:koReSicht>Kostenstelle</rw:koReSicht>
            <rw:aobj>2010</rw:aobj>
            <rw:betrag>44.95</rw:betrag>
            <rw:betragHW>44.95</rw:betragHW>
            <rw:soll>true</rw:soll>
          </rw:aobjKontierungen>
        </rw:belPositionen>

        <!-- ═══════════════════════════════════════════════════════════
             Position 2: Hotelkosten (19% VSt, brutto=true)
             Brutto: 64,44 €
             Netto:  54,15 € = 64,44 / 1,19  (gerundet)
             VSt:    10,29 €
             ═══════════════════════════════════════════════════════════ -->
        <rw:belPositionen>
          <rw:positionsart>Sachbuchung</rw:positionsart>
          <rw:kontotitel>REISEKOSTEN</rw:kontotitel>

          <rw:betrag>64.44</rw:betrag>
          <rw:betragHW>64.44</rw:betragHW>
          <rw:soll>true</rw:soll>
          <rw:brutto>true</rw:brutto>
          <rw:ustSchluessel>VSt 19%</rw:ustSchluessel>

          <rw:text>Hotel Mercure Berlin 2 Nächte</rw:text>

          <!-- Nettobetrag für Kostenstellen-Zuordnung: 64,44 / 1,19 = 54,15 -->
          <rw:aobjKontierungen>
            <rw:koReSicht>Kostenstelle</rw:koReSicht>
            <rw:aobj>2010</rw:aobj>
            <rw:betrag>54.15</rw:betrag>
            <rw:betragHW>54.15</rw:betragHW>
            <rw:soll>true</rw:soll>
          </rw:aobjKontierungen>
        </rw:belPositionen>

      </rw:belegdaten>

      <rw:benutzeAutoKontierung>false</rw:benutzeAutoKontierung>

    </rw:insertBeleg>
  </soapenv:Body>

</soapenv:Envelope>
